# ============================================================================
# CreditPass - environment
# Copy to .env and fill in. NEVER commit .env
# ============================================================================

# --- Attestcoin / Creditcoin CC3 Testnet constants ---------------------------
# Source chain: Ethereum Sepolia is chainKey 1 on CC3 Testnet.
SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_RPC_URL="https://sepolia.infura.io/v3/<your_key>"   # or any Sepolia RPC
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"

# Proof Builder service (generates Merkle + continuity proofs for readability)
PROOF_BUILDER_URL="https://proof-gen-api.cc3-testnet.creditcoin.network"

# Creditcoin CC3 Testnet precompiles / libraries
BLOCK_PROVER_PRECOMPILE="0x0000000000000000000000000000000000000FD2"
CHAIN_INFO_PRECOMPILE="0x0000000000000000000000000000000000000fd3"
EVM_V1_DECODER_LIBRARY_ADDRESS="0x04B9ae8562D8Cc5bbbBbBB759080dDC30B56D18B"
DECODER_CONTRACT_ADDRESS="0x731c345d79Fb8BbDC541f9DF3b6317585F849F9f"

# --- User-provided keys ------------------------------------------------------
# Deployer / operator key. On testnet this pays gas on BOTH Sepolia and Creditcoin.
# Get testnet CTC (gas) from the Creditcoin Discord faucet: https://discord.gg/Gu43zTfmtc
DEPLOYER_PRIVATE_KEY=""
# Borrower key on Sepolia (simulates a real borrower with cross-chain history)
BORROWER_PRIVATE_KEY=""
# Optional: separate key for the AI underwriting agent (defaults to DEPLOYER_PRIVATE_KEY)
AGENT_PRIVATE_KEY=""

# --- Deployed addresses (filled by deploy scripts) ---------------------------
SOURCE_CHAIN_COLLATERAL_TOKEN_ADDRESS=""
CREDIT_HISTORY_SOURCE_ADDRESS=""
MOCK_LENDING_VENUE_ADDRESS=""
MOCK_USD1_ADDRESS=""
CREDIT_PASSPORT_ASC_ADDRESS=""
CREDIT_POLICY_ADDRESS=""
CREDIT_POOL_ADDRESS=""

# --- AI underwriting agent ---------------------------------------------------
# optional: if unset the agent uses a deterministic template for the rationale
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
